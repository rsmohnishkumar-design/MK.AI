# Required for real AI answers: your Google Gemini API key. Get one free
# (no card needed) at https://aistudio.google.com/apikey. Without it,
# MK.ai only shows raw search results instead of writing answers.
GEMINI_API_KEY=

# Optional: which Gemini model writes the answers.
GEMINI_MODEL=gemini-flash-latest

# The passcode for the hidden vault room. Change this to something only
# you know — this is basic protection, not production-grade security
# (it's a single shared passcode with no rate-limiting or encryption).
VAULT_PASSCODE=changeme

# Required for real use: the secret used to sign user login sessions.
# Set this to a long random string — e.g. run `openssl rand -hex 32`
# and paste the output here. If left blank, an insecure default is
# used and a warning is printed on startup.
JWT_SECRET=

# Set to "false" to close self-signup (existing accounts can still log
# in; new visitors are told to contact the admin). Defaults to open.
ALLOW_SIGNUP=true

# Entering this code on the sign-up (or login) form grants unlimited
# access instead of the default 3-hour trial. Change this to something
# only you know — it ships as "6971" by default, which anyone reading
# this file (or the app's source) could find.
UNLIMITED_ACCESS_CODE=6971

# How long a trial account (no access code entered) can use the chat
# before it's locked out.
TRIAL_HOURS=3

# Optional: port to run the server on
PORT=3000

# Optional: set to "false" to watch the browser actually search in a
# visible window instead of running headless.
HEADLESS=true

# Firebase Firestore database. Strongly recommended when hosting online:
# without it, data is kept in local files (data/), which free hosts like
# Render wipe on every restart, losing all accounts and everything MK.ai
# has learned. Get these from a Firebase service account: Firebase
# Console → Project Settings → Service Accounts → Generate new private
# key. Leave all three blank to use local files (fine on your own computer).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
