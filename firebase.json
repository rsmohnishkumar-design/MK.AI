{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/__pycache__/**",
      ".firebase/**",
      ".git/**",
      "**/.*",
      "**/node_modules/**",
      "kb-src/**",
      "apps-src/**",
      "robot/**",
      "README.md",
      "firestore.rules",
      "CLAUDE.md",
      "tests/**",
      "gateway/**",
      "nova-llm/**",
      "docs/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "X-Frame-Options",
            "value": "SAMEORIGIN"
          },
          {
            "key": "Content-Security-Policy",
            "value": "frame-ancestors 'self'; base-uri 'self'; object-src 'none'"
          }
        ]
      },
      {
        "source": "/sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/embed/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=300"
          }
        ]
      }
    ]
  }
}
