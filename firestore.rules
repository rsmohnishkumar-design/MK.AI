rules_version = '2';

// Security rules for Nova AI. Paste this whole file into
// Firebase console → Firestore Database → Rules, then click Publish.

service cloud.firestore {
  match /databases/{database}/documents {

    // ===== EDIT THESE THREE LINES BEFORE PUBLISHING =====
    // Your email, in lowercase: the admin who can open the vault. Sign up in
    // Nova AI with this email before publishing, so nobody else can claim it
    // (Firebase never allows two accounts with the same email).
    function adminEmails() { return ['your-email@example.com']; }
    // The access code that unlocks unlimited use. Keep it secret.
    function unlimitedCode() { return 'change-this-code'; }
    // The creator's secret code: saying "I created you" in the chat asks for it.
    function creatorCode() { return 'change-this-creator-code'; }
    // The vault password: checked here, never stored in the website's code
    function vaultCode() { return 'change-this-vault-password'; }
    // The team training code: lets team members into the Training Room only (not the vault)
    function trainerCode() { return 'change-this-trainer-code'; }
    // ====================================================

    // Trial length: 3 hours (180 minutes) plus 5 minutes for clock differences.
    // Must match TRIAL_HOURS in firebase-config.js.
    function maxTrialMinutes() { return 185; }

    function signedIn() { return request.auth != null; }

    // The admin: the email above, or the account verified as Nova AI's creator
    // (with the creator code) in the chat.
    function isAdmin() {
      return signedIn() && (request.auth.token.email in adminEmails() || isCreator());
    }
    // Team trainers: may only work with training data (the trainingData collection)
    function isTrainer() {
      let profile = /databases/$(database)/documents/users/$(request.auth.uid);
      return signedIn() && exists(profile) && get(profile).data.get('trainer', false) == true;
    }
    function isCreator() {
      let profile = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(profile) && get(profile).data.get('creator', false) == true;
    }

    function incoming() { return request.resource.data; }

    // Free-plan usage (times in milliseconds). A count may only grow; it may restart
    // from zero only after its window (5 hours) or week has passed, and a new start
    // time must be "now" (within 10 minutes) so nobody can push it into the future.
    function nowMs() { return request.time.toMillis(); }
    function freshStart(t) { return t is int && t <= nowMs() + 600000 && t >= nowMs() - 600000; }
    function counterOk(newStart, newCount, oldStart, oldCount, spanMs) {
      return newStart is int && newCount is number && newCount >= 0 && (
        (newStart == oldStart && newCount >= oldCount)
        || ((oldStart == 0 || nowMs() >= oldStart + spanMs) && (newStart == 0 || freshStart(newStart)))
      );
    }
    function usageOk(u, old) {
      return counterOk(u.windowStart, u.windowTokens, old.get('windowStart', 0), old.get('windowTokens', 0), 18000000)
        && counterOk(u.weekStart, u.weekTokens, old.get('weekStart', 0), old.get('weekTokens', 0), 604800000);
    }
    function changed() { return incoming().diff(resource.data).affectedKeys(); }

    // Unlimited and free-plan accounts (the free plan's token limits are counted in the app).
    function hasAccess() {
      let profile = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return profile.tier == 'unlimited' || profile.tier == 'trial';
    }

    // --- Accounts: one profile per user, created at first sign-in ---
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

      allow create: if signedIn() && request.auth.uid == uid
        && incoming().email == request.auth.token.email
        && incoming().createdAt == request.time
        && (
          (incoming().keys().hasOnly(['email', 'tier', 'expiresAt', 'createdAt'])
            && incoming().tier == 'trial'
            && incoming().expiresAt is timestamp
            && incoming().expiresAt > request.time
            && incoming().expiresAt <= request.time + duration.value(maxTrialMinutes(), 'm'))
          || (incoming().keys().hasOnly(['email', 'tier', 'expiresAt', 'createdAt', 'accessCode'])
            && incoming().tier == 'unlimited'
            && incoming().expiresAt == null
            && incoming().accessCode == unlimitedCode())
        );

      // People can only upgrade themselves, and only with the right code.
      // The creator mark needs the creator code, even for the admin.
      allow update: if (isAdmin() && !changed().hasAny(['creator', 'creatorCode'])) || (
        signedIn() && request.auth.uid == uid
        && changed().hasOnly(['tier', 'expiresAt', 'accessCode'])
        && resource.data.tier == 'trial'
        && incoming().tier == 'unlimited'
        && incoming().expiresAt == null
        && incoming().accessCode == unlimitedCode()
      ) || (
        // Usage can only go up, except when a 5-hour window or a week has really ended.
        signedIn() && request.auth.uid == uid
        && changed().hasOnly(['usage'])
        && incoming().usage is map
        && incoming().usage.keys().hasOnly(['windowStart', 'windowTokens', 'weekStart', 'weekTokens'])
        && usageOk(incoming().usage, resource.data.get('usage', {}))
      ) || (
        signedIn() && request.auth.uid == uid
        && changed().hasOnly(['accessRequest'])
        && incoming().accessRequest.keys().hasOnly(['status', 'at'])
        && incoming().accessRequest.status == 'pending'
        && incoming().accessRequest.at == request.time
        && resource.data.tier == 'trial'
        && (!('accessRequest' in resource.data) || resource.data.accessRequest.status != 'pending')
      ) || (
        signedIn() && request.auth.uid == uid
        && changed().hasOnly(['limitHits', 'limitHitAt'])
        && incoming().limitHits == resource.data.get('limitHits', 0) + 1
        && incoming().limitHitAt == request.time
        && (!('limitHitAt' in resource.data) || request.time > resource.data.limitHitAt + duration.value(6, 'd'))
      ) || (
        signedIn() && request.auth.uid == uid
        && changed().hasOnly(['tier', 'expiresAt', 'autoUnlimited'])
        && resource.data.tier == 'trial'
        && resource.data.get('limitHits', 0) >= 5
        && incoming().tier == 'unlimited'
        && incoming().expiresAt == null
        && incoming().autoUnlimited == true
      ) || (
        // Join the training team with the team code (then the app removes the code again)
        signedIn() && request.auth.uid == uid
        && changed().hasOnly(['trainer', 'trainerCode'])
        && incoming().trainer == true
        && incoming().trainerCode == trainerCode()
      ) || (
        signedIn() && request.auth.uid == uid
        && changed().hasOnly(['trainerCode'])
        && !('trainerCode' in incoming())
      ) || (
        signedIn() && request.auth.uid == uid
        && changed().hasOnly(['creator', 'creatorCode'])
        && incoming().creator == true
        && (incoming().creatorCode == creatorCode() || incoming().creatorCode == vaultCode())
      );

      allow delete: if isAdmin();

      // Each person's saved chats: only they can read or change them.
      // Code School progress: which lessons and exercises are ticked.
      match /progress/{docId} {
        allow read, delete: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn() && request.auth.uid == uid
          && docId == 'learn'
          && incoming().keys().hasOnly(['done', 'ex', 'updatedAt'])
          && incoming().done is map && incoming().done.size() <= 30
          && incoming().ex is map && incoming().ex.size() <= 30
          && incoming().updatedAt == request.time;
      }

      match /chats/{chatId} {
        allow read, delete: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn() && request.auth.uid == uid
          && incoming().keys().hasOnly(['title', 'updatedAt', 'messages'])
          && incoming().title is string && incoming().title.size() <= 200
          && incoming().updatedAt is int
          && incoming().messages is list && incoming().messages.size() <= 100;
      }
    }

    // --- Curated answers: everyone can read, only the admin can change ---
    // Documents taught in the Training room, split into passages.
    match /knowledge/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /vault/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // --- Learned memory ---
    match /learned/{id} {
      allow read: if signedIn();

      // Only the admin adds shared answers: answers from one person are shown to everyone
      allow create: if isAdmin()
        && incoming().keys().hasOnly([
          'question', 'answer', 'keywords', 'timeSensitive', 'uses', 'voters',
          'createdBy', 'createdAt', 'lastUsedAt', 'source'
        ])
        && (!('source' in incoming()) || incoming().source in ['ai', 'wikipedia', 'taught'])
        && incoming().createdBy == request.auth.uid
        && incoming().question is string && incoming().question.size() <= 1000
        && incoming().answer is string && incoming().answer.size() <= 20000
        && incoming().keywords is list && incoming().keywords.size() <= 50
        && incoming().timeSensitive is bool
        && incoming().uses == 1
        && incoming().voters == {}
        && incoming().createdAt == request.time
        && incoming().lastUsedAt == request.time;

      // Anyone with access can count a use, or set their own single vote.
      allow update: if isAdmin() || (signedIn() && hasAccess() && (
        (changed().hasOnly(['uses', 'lastUsedAt'])
          && incoming().uses == resource.data.uses + 1
          && incoming().lastUsedAt == request.time)
        || (changed().hasOnly(['voters'])
          && incoming().voters.diff(resource.data.voters).affectedKeys().hasOnly([request.auth.uid])
          && incoming().voters[request.auth.uid] in ['up', 'down'])
      ));

      allow delete: if isAdmin();
    }

    // --- Settings. settings/ai holds the AI service keys: only the admin may read it,
    // so keys never reach other people's browsers (everyone else uses Gemini through
    // Firebase, or the Nova Gateway once it is set up). Other settings: members read. ---
    match /settings/{id} {
      allow read: if (id == 'ai' && isAdmin()) || (id != 'ai' && signedIn() && hasAccess());
      allow write: if isAdmin();
    }

    // --- Learning list: questions Nova AI couldn't answer yet. Open Nova AI pages
    // research them in the background and delete each one once it's learned. ---
    match /unknown/{id} {
      allow read: if signedIn() && hasAccess();
      allow create: if signedIn() && hasAccess()
        && incoming().keys().hasOnly(['question', 'tries', 'createdBy', 'createdAt'])
        && incoming().question is string && incoming().question.size() <= 500
        && incoming().tries == 0
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time;
      allow update: if signedIn() && hasAccess()
        && changed().hasOnly(['tries', 'lastTriedAt'])
        && incoming().tries == resource.data.tries + 1
        && incoming().lastTriedAt == request.time;
      allow delete: if isAdmin() || (signedIn() && resource.data.createdBy == request.auth.uid);
    }

    // --- Agent tasks and memory live on each person's device (js/agent), not here. ---

    // --- Team training data (Training Room): trainers and the admin only ---
    function validExample(d) {
      return d.question is string && d.question.size() >= 1 && d.question.size() <= 500
        && d.answer is string && d.answer.size() >= 1 && d.answer.size() <= 2000
        && d.topic is string && d.topic.size() <= 40
        && d.source is string && d.source.size() >= 1 && d.source.size() <= 300
        && d.licence in ['own', 'public-domain', 'cc0', 'cc-by', 'cc-by-sa'];
    }
    match /trainingData/{id} {
      allow read: if isTrainer() || isAdmin();
      allow create: if (isTrainer() || isAdmin())
        && incoming().keys().hasOnly(['question', 'answer', 'topic', 'source', 'licence', 'author', 'createdBy', 'createdAt', 'updatedAt', 'status'])
        && validExample(incoming())
        && incoming().author is string && incoming().author.size() <= 60
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && incoming().status == 'pending';
      // Authors edit their own examples until the admin approves them; the admin can do anything
      allow update: if isAdmin() || (isTrainer()
        && resource.data.createdBy == request.auth.uid
        && resource.data.status == 'pending'
        && changed().hasOnly(['question', 'answer', 'topic', 'source', 'licence', 'updatedAt'])
        && validExample(incoming())
        && incoming().updatedAt == request.time);
      allow delete: if isAdmin() || (isTrainer() && resource.data.createdBy == request.auth.uid && resource.data.status == 'pending');
    }

    // --- Activity log: people add their own entries, only the admin reads ---
    match /activity/{id} {
      allow create: if signedIn()
        && incoming().keys().hasOnly(['question', 'mode', 'uid', 'email', 'createdAt'])
        && incoming().uid == request.auth.uid
        && incoming().email == request.auth.token.email
        && incoming().question is string && incoming().question.size() <= 1000
        && incoming().mode is string && incoming().mode.size() <= 20
        && incoming().createdAt == request.time;
      allow read, delete: if isAdmin();
    }
  }
}
